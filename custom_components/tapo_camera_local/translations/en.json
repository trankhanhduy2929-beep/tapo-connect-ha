        "title": "Sign in to your Tapo account",
        "description": "Home Assistant reads face notifications from your Tapo account: enter the email and password used in the Tapo app, a code by email if Tapo asks, then pick the camera. Local standalone login was removed as a sign-in option; existing local entries keep working."
      },
      "tapo_control": {
        "title": "Use existing Tapo Control",
        "description": "Select the working C260 from Tapo: Cameras Control. This companion only adds read-only sensors and face metadata. It does not copy passwords or close the source connection. Keep Tapo Control installed and enabled.",
        "data": {
          "tapo_control_entry_id": "Camera in Tapo Control"
        }
      },
      "standalone": {
        "title": "Independent camera login",
        "description": "Native pytapo local login, no Tapo Control required. Creates only settings exposed by the camera. Face APIs depend on firmware. Uses self-signed TLS: trusted LAN only.",
        "data": {
          "host": "Camera IP or hostname",
          "port": "HTTPS control port",
          "auth_mode": "Account type",
          "username": "Camera Account username (ignored for Tapo account)",
          "password": "Password for the selected account",
          "name": "Name",
          "stream_url": "RTSP URL (optional, separate credentials)"
        },
        "data_description": {
          "auth_mode": "Tapo account: use the password you use in the Tapo app; local API username is admin, not your email. Camera Account: use the account created in the camera settings if your firmware accepts it.",
          "username": "Only used for Camera Account. Tapo account mode always uses admin.",
          "password": "Sent to the camera on your LAN, not to a cloud login API. Stored in the HA config entry; protect your configuration and backups.",
          "stream_url": "Do not reuse the Tapo password for RTSP. Leave omitted to keep an existing URL during reconfiguration; submit an empty value to remove it."
        }
      },
