          "email": "Tapo email",
          "password": "Tapo password",
          "region": "Region code (optional)"
        }
      },
      "cloud_mfa": {
        "title": "Tapo email verification",
        "description": "Enter the six-digit code sent to your Tapo email. Keep leading zeroes. One verification request is sent; do not share the code. If it is rejected or expired, start sign-in again. MFA is never disabled and this machine is not marked trusted.",
        "data": {
          "code": "Verification code"
        }
      },
      "cloud_device": {
        "title": "Choose your camera",
        "description": "Select a C260. HA keeps face name/time sensors and adds person, stranger, pet, vehicle and sound notifications plus camera settings over cloud. Notifications default to 5 seconds (30 when idle); settings sync independently every 30 seconds. No local login or Tapo Control needed. Cloud images/video are not implemented.",
        "data": {
          "camera_id": "Camera"
        }
      },
